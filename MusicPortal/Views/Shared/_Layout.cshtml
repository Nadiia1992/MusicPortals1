﻿@using Microsoft.AspNetCore.Builder
@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options


@inject IStringLocalizer<MusicPortal.Resource> Localizer
@inject IOptions<RequestLocalizationOptions> LocOptions

@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();

    var cultureItems = LocOptions.Value.SupportedUICultures
        .Select(c => new SelectListItem { Value = c.Name, Text = c.NativeName })
        .ToList();

    var returnUrl = string.IsNullOrEmpty(Context.Request.Path) ? "~/" : $"~{Context.Request.Path.Value}";
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MusicPortal</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="header-container">
            <a asp-controller="Home" asp-action="Index" class="logo">
                <img src="~/image/imagesLogo.jpg" alt="MusicPortal" />
                <span class="logo-text">
                    <span class="music">Music</span><span class="portal">Portal</span>
                </span>
            </a>

            <form asp-controller="Home" asp-action="SetLanguage" asp-route-returnUrl="@returnUrl" method="post" class="d-flex align-items-center ms-auto language-form">
                <select name="culture"
                        asp-for="@requestCulture!.RequestCulture.UICulture.Name"
                        asp-items="cultureItems"
                        class="form-select form-select-sm language-select"
                        onchange="this.form.submit();">
                </select>
            </form>

            <nav class="navigat">
                @{
                    var login = Context.Session.GetString("Login");
                    var firstName = Context.Session.GetString("FirstName");
                }

                @if (login == "ADMIN")
                {
                    <span class="welcome-text">
                        Вітаю, @(string.IsNullOrEmpty(firstName) ? login : firstName)!
                    </span>

                    <a asp-controller="Admin" asp-action="Index" class="addsong">
                        <span class="plus">+</span>
                        @Localizer["AdminPanel"]
                    </a>

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="logout-form">
                        <button type="submit" class="logout-btn">@Localizer["Logout"]</button>
                    </form>
                }

                else if (!string.IsNullOrEmpty(login))
                {
                    <span class="welcome-text">
                        Вітаю, @(string.IsNullOrEmpty(firstName) ? login : firstName)!
                    </span>
                    <a asp-controller="Song" asp-action="Create" class="addsong">
                        <span class="plus">+</span>
                        @Localizer["CreateSong"]
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                        <button type="submit" class="logout-btn">@Localizer["Logout"]</button>
                    </form>
                }
                else
                {
                    <a class="navigation" asp-controller="Account" asp-action="Login">
                        @Localizer["Enter"]
                    </a>

                    <a class="navigation" asp-controller="Account" asp-action="Register">
                        @Localizer["Register"]
                    </a>
                }
            </nav>

    </header>

    <div class="page-container">
        <aside class="sidebar">
           
            <nav class="sidebar-navigation">
                <a asp-controller="Home" asp-action="Index"><i data-lucide="house"></i><span>@Localizer["Main"]</span></a>
                <a asp-controller="Song" asp-action="Index"><i data-lucide="music"></i><span>@Localizer["Music"]</span></a>
                <a asp-controller="Genre" asp-action="Start"><i data-lucide="audio-lines"></i><span>@Localizer["Genres"]</span></a>
                <a asp-controller="Singer" asp-action="Show"><i data-lucide="circle-user-round"></i><span>@Localizer["Artists"]</span></a>
                </nav>
                </aside>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - MusicPortal - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://unpkg.com/lucide@latest"></script>

    <script>
            lucide.createIcons();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
