@model IEnumerable<MusicPortal.Models.Song>
@{
    ViewData["Title"] = "Пісні на модерації";
}
<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />

@if (Model == null || !Model.Any())
{
    <p>Немає пісень на модерації.</p>
}
else
{
    @foreach (var item in Model)
    {
        <div class="song-card">
            <div class="song-image">
                <img src="@item.Foto" alt="@item.NameOfSong" />
            </div>
            <div class="song-info">
                <h4>@item.NameOfSong</h4>
                <h4>@item.Singer?.Singer</h4>
                <p>@item.Genre?.Genre</p>

                <audio controls>
                    <source src="@item.AudioPath" />
                    Ваш браузер не підтримує відтворення аудіо.
                </audio>
                <a href="@item.AudioPath"
                class="download-button"
                download
                title="Скачати">
                    <i data-lucide="download"></i>
                </a>
                <form asp-controller="Song"
                      asp-action="Accept"
                      method="post">
                <input type="hidden" name="id" value="@item.Id" />

                <button type="submit" class="save-song-btn">
                    Підтвердити пісню
                </button>
                </form>

            </div>
        </div>
    }
}
<a asp-controller="Account" asp-action="Admin">
    Назад
</a>
