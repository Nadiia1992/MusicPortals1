@model IEnumerable<MusicPortal.Models.Song>
@{
    ViewData["Title"] = "Відгуки";
}


<div class="reviews">

    @foreach (var item in Model)
    {
        <div class="review">
            <div class="card shadow-sm border-0">
                <div class="card-body d-flex flex-column">

                    <div class="review-header">
                        <h4>@Html.DisplayFor(modelItem => item.User!.Login)</h4>
                        <span>@Html.DisplayFor(modelItem => item.NameOfSong)</span>
                    </div>

                    <hr />
                    <p class="align-middle">@Html.DisplayFor(modelItem => item.Genre)</p>
                    @if (!string.IsNullOrEmpty(item.Foto))
                    {
                        <img class="foto" src="@item.Foto" alt="Фото відгуку" />
                    }


                </div>
            </div>
        </div>
    }
</div>