@model MusicPortal.Models.LoginModel

@{
    ViewBag.Title = "Вхід";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
<div class="login-page">


<div class="login-card">
    <div class="login-card-header">
        <div class="login-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.33-8 4v2h16v-2c0-2.67-5.33-4-8-4z"/>
            </svg>
        </div>
        <h2>Вхід в систему</h2>
        <p>Будь ласка, увійдіть у свій обліковий запис</p>
    </div>
    <div class="login-card-body">
            <form asp-controller="Account" asp-action="Login">
                
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="login-field">
                        <input asp-for="Login" class="login-input" placeholder="Ваш Login" />
                    <span asp-validation-for="Login" class="text-danger"></span>
                    </div>

                    <div class="login-field">
                        <input asp-for="Password" class="login-input" placeholder="Введіть пароль" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="login-buttons">
                        <button type="submit" class="login-button">Увійти</button>
                    </div>

                    <a asp-controller="Account" asp-action="Register" class="register-button">Реєстрація</a>
                </form>
            </div>
        </div>
    </div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

   
 
