@model IEnumerable<MusicPortal.Models.Song>
@{
    ViewData["Title"] = "Клієнт";

}

﻿@using Microsoft.AspNetCore.Builder
@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options


<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
@inject IStringLocalizer<MusicPortal.Resource> Localizer
@inject IOptions<RequestLocalizationOptions> LocOptions

@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();

    var cultureItems = LocOptions.Value.SupportedUICultures
        .Select(c => new SelectListItem { Value = c.Name, Text = c.NativeName })
        .ToList();

    var returnUrl = string.IsNullOrEmpty(Context.Request.Path) ? "~/" : $"~{Context.Request.Path.Value}";
}

<link rel="stylesheet" href="~/css/client.css" asp-append-version="true" />

<section class="hero">
    <div class="hero-content">
        <h1>@Localizer["Title"]</h1>
        <p>@Localizer["Info"]</p>
    </div>

    <img class="main-photo" src="~/picture/startfoto.jpg" alt="Стартова фотографія" />

</section>

            <div class="addsong-container">
                <a asp-controller="Song" asp-action="Create" class="addsong">
        <span class="plus">+</span>@Localizer["CreateSong"]
                </a>
            </div>
<div class="songs">
    @foreach (var item in Model)
    {
        <div class="song-card">
            <div class="song-image">
                <img src="@item.Foto" alt="@item.NameOfSong" />
            </div>
            <div class="song-info">
                <h4>@item.NameOfSong</h4>
                <h4>@item.Singer?.Singer</h4>
                <p>@item.Genre?.Genre</p>

                <audio controls>
                    <source src="@item.AudioPath" />
                    Ваш браузер не підтримує відтворення аудіо.
                </audio>
                <a href="@item.AudioPath"
                   class="download-button"
                   download
                   title="Скачати">
                    <i data-lucide="download"></i>
                </a>

            </div>
        </div>
    }

</div>
