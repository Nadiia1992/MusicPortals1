@model MusicPortal.Models.Genres

@{
    ViewData["Title"] = "Додати жанр";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/genre.css" asp-append-version="true" />

<main class="create-song-page">
    <div class="create-song-container">

        <div class="create-song-heading">
            <div class="create-song-icon">♫</div>
            <h1>Додати новий жанр</h1>
            <p>Створіть новий жанр для музичних композицій</p>
        </div>

        <div class="create-song-card">
            <form asp-controller="Admin"
                  asp-action="CreateGenre"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="Genre" class="form-label">
                        Назва жанру
                    </label>

                    <input asp-for="Genre"
                           class="form-control music-input"
                           placeholder="Наприклад, рок, поп, джаз..." />

                    <span asp-validation-for="Genre"
                          class="text-danger"></span>
                </div>

                <div class="create-song-actions">
                    <a asp-controller="Admin"
                       asp-action="Genres"
                       class="back-song-btn">
                        ← Повернутися
                    </a>

                    <button type="submit" class="save-song-btn">
                        <span>＋</span> Додати жанр
                    </button>
                </div>
            </form>
        </div>
    </div>
</main>
