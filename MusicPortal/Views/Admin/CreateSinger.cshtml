@model MusicPortal.Models.Singers

@{
    ViewData["Title"] = "Додати виконавця";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/genre.css" asp-append-version="true" />

<main class="create-song-page">
    <div class="create-song-container">

        <div class="create-song-heading">
            <div class="create-song-icon">♫</div>
            <h1>Додати нового виконавця</h1>
      
        </div>

       <div class="create-song-card">
            <form asp-controller="Admin"
                  asp-action="CreateSinger"
                  method="post" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="Singer" class="form-label">
                        Назва виконавця
                    </label>

                    <input asp-for="Singer"
                           class="form-control music-input"
                           placeholder="Наприклад, Pink, Katy Perry..." />

                    <span asp-validation-for="Singer"
                          class="text-danger"></span>
                </div>

                    <div class="edit-genre-field">
                        <label asp-for="Image" class="form-label fw-bold"></label>
                        <input name="posterFile" class="form-control" type="file" accept="image/png, image/jpeg" placeholder="Введіть постер" />
                        <span asp-validation-for="Image" class="text-danger"></span>
                    </div>
       

                <div class="create-song-actions">
                    <a asp-controller="Admin"
                       asp-action="Singers"
                       class="back-song-btn">
                        ← Повернутися
                    </a>

                    <button type="submit" class="save-song-btn">
                        <span>＋</span> Додати виконавця
                    </button>
                </div>
            </form>
        </div>
    </div>
</main>
