@model MusicPortal.Models.Genres

@{
    ViewData["Title"] = "Видалення жанру";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/genre.css" asp-append-version="true" />

<div class="edit-genre-page delete-genre-page">


    <div class="delete-genre-card">
        <div class="delete-genre-icon">!</div>

        <h2 class="delete-genre-title">Ви впевнені?</h2>

        <p class="delete-genre-description">
            Ви збираєтеся видалити жанр:
        </p>

        <div class="delete-genre-name">
            ♫ @Model.Genre
        </div>

        <p class="delete-genre-warning">
            Цю дію може бути неможливо скасувати.
        </p>

        <form asp-action="DeleteConfirmed" method="post">
            <input type="hidden" asp-for="Id" />

            <button type="submit" class="delete-genre-confirm">
                <span>✕</span> Так, видалити жанр
            </button>

            <a asp-controller="Admin"
               asp-action="Genres"
               class="edit-genre-back">
                ← Скасувати та повернутися
            </a>
        </form>
    </div>
</div>
